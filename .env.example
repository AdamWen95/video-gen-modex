# Modex 服务根地址；不要包含 /v1、/v1/videos 或 /v1/video/generations。
# 页面默认使用 Seedance 2.0 接口，也可选择旧版 Modex 格式生成或查询原有任务。
MODEX_BASE_URL=https://your-modex-api.example.com

# 替换为你的 Modex API Key。
MODEX_API_KEY=replace-with-your-modex-api-key

# 替换为当前账号实际可用的 Seedance 模型标识。
# 参考视频功能需支持多模态输入的 Seedance 2.0 模型，例如 doubao-seedance-2-0-260128。
DEFAULT_MODEL=your-seedance-model
